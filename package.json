{
  "name": "axis-allies-global-1940",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Online play-by-cloud implementation of Axis & Allies Global 1940 (2nd Edition).",
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/engine/**/*.test.ts"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "better-sqlite3": "^11.3.0",
    "d3-delaunay": "^6.0.4",
    "d3-geo": "^3.1.1",
    "d3-geo-voronoi": "^2.1.0",
    "express": "^4.19.2",
    "nanoid": "^5.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/d3-delaunay": "^6.0.4",
    "@types/d3-geo": "^3.1.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  }
}
